# --- FINAN-X · archivos que NO se sincronizan con git ---

# Dependencias instaladas (se regeneran con npm install)
node_modules/

# Compilados del frontend
dist/
build/

# Variables de entorno / secretos
.env
.env.*
!.env.example

# Registros y temporales
*.log
.DS_Store
Thumbs.db
*.tmp

# Documentos generados (se regeneran con los scripts)
# NOTA: los PDF de la doc SI viajan por git (para tenerlos en ambas PC).
documentacion/*.html

# Respaldos de la base de datos (no deben ir por git)
respaldo/

# Datos locales sueltos
nodemon.json

# --- Seguridad y despliegue ---
# Certificados TLS locales (se generan con deploy/generar-certificado.*)
certs/
# Claves temporales de las cuentas iniciales (se entregan aparte, nunca por git)
primer-ingreso/*.json
primer-ingreso/Acta-*.pdf
primer-ingreso/Acta-*.md
# Respaldos de base de datos
respaldo/
# Caché y temporales de npm/tareas
.npm-cache/
.tmp/
# Carpeta de construcción temporal del empaquetado
_build-version-final/

# --- Carpeta de entrega (se construye aparte y se publica como Release) ---
# Contiene el paquete USB con las imagenes de Docker (~191 MB) y los lanzadores.
# Supera el limite de 100 MB por archivo de GitHub, asi que no viaja en git.
entrega/

# --- Material de estudio personal (no se publica) ---
documentacion/01-academica/Guia_Estudio_Presentacion.*

# --- Notas de trabajo personales (no se publican) ---
documentacion/07-notas-internas/
