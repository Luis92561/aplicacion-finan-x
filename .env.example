# =====================================================================
# FINAN-X · Variables de entorno del stack (copiar a .env)
#
#   cp .env.example .env
#
# NUNCA suba el archivo .env al repositorio. Genere los secretos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =====================================================================

# ---------- Sesión ----------
JWT_SECRET=
JWT_EXPIRES=2h

# ---------- Base de datos ----------
# Contraseña del superusuario de PostgreSQL (solo init/migraciones).
POSTGRES_PASSWORD=
# Contraseña del rol de aplicación (privilegios mínimos).
APP_DB_PASSWORD=

# ---------- Red ----------
NODE_ENV=production
DOMAIN=localhost
# Orígenes permitidos por CORS, separados por coma. En producción, el dominio HTTPS.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# "on" solo si se sirve por HTTPS (modo seguro o producción con certificado).
COOKIE_SECURE=off

# ---------- Funciones de demostración ----------
# En producción el OTP de demostración queda apagado siempre (regla del código).
OTP_RETORNO_DEMO=off
# Autoregistro público de clientes: apagado por defecto.
REGISTRO_ABIERTO=off
# Seed de datos de demostración: solo para desarrollo.
SEED_DEMO=false

# ---------- Límites anti-abuso ----------
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
REGISTRO_RATE_LIMIT=20
RECUPERAR_RATE_LIMIT=40
OTP_VALIDEZ_MINUTOS=10
OTP_MAX_INTENTOS=5
OTP_COOLDOWN_SEGUNDOS=60
RATE_LIMIT_GLOBAL=300
BCRYPT_ROUNDS=12
