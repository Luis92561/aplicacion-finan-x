# =====================================================================
# FINAN-X · Variables de entorno del backend (MODO DESARROLLO)
# ---------------------------------------------------------------------
# Copie este archivo como `.env` y ajuste los valores:
#     cp .env.example .env        (Linux/Mac)
#     copy .env.example .env      (Windows)
#
# El archivo `.env` está en .gitignore: NO se sube al repositorio.
# =====================================================================

# ---------- Servidor ----------
PORT=4000

# ---------- Base de datos ----------
PGHOST=localhost
PGPORT=5432
PGUSER=finanx
PGPASSWORD=finanx
PGDATABASE=finanx

# ---------- Seguridad ----------
# OBLIGATORIO. Firma los tokens de sesión (JWT).
# El backend NO arranca si falta, si mide menos de 32 caracteres o si contiene
# alguno de los valores de ejemplo que están publicados en el repositorio
# (con un secreto conocido cualquiera puede forjar tokens y suplantar a
# cualquier usuario, incluido el administrador).
#
# Genere uno aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES=8h

# ---------- CORS ----------
# Orígenes que el navegador tiene permitido llamar (separados por comas).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# ---------- Límites anti-abuso (por IP) ----------
# Intentos fallidos de login antes de bloquear 429 (ventana de 15 min).
LOGIN_MAX_FAILURES=5
# Autoregistros de cliente permitidos por hora.
REGISTRO_RATE_LIMIT=20
# Solicitudes/intentos de recuperación de contraseña cada 15 min.
RECUPERAR_RATE_LIMIT=40

# ---------- Recuperación de contraseña (OTP) ----------
# on  = el código se devuelve en la respuesta de la API y se imprime en consola.
#       Sirve para demostrar el flujo sin un proveedor real de SMS/correo.
#       ⚠️ ANULA el segundo factor: nunca en producción.
# off = el código no se expone; habría que enviarlo por SMS/correo real
#       (conectar el proveedor en src/middleware/notificar.js).
#
# Si se deja vacío, el backend decide según NODE_ENV:
#   producción -> off   ·   desarrollo -> on
OTP_RETORNO_DEMO=

# Minutos de validez del código.
OTP_VALIDEZ_MINUTOS=10
# Intentos permitidos por código antes de invalidarlo.
OTP_MAX_INTENTOS=5
